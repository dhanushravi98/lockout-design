 "rows": [
  {
   "k": "Font family",
   "v": "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
  },
  {
   "k": "Sizes",
   "v": "11, 12, 13 (labels, badges) / 14, 15 (body) / 17 (section) / 24 (overlay title) / 32 (page title, fluid 24 to 32)"
  },
  {
   "k": "Weights",
   "v": "500 titles, 600 labels and chips, 700 buttons and badges, 800 page headings"
  },
  {
   "k": "Radius: pills, buttons, inputs",
   "v": "999px"
  },
  {
   "k": "Radius: cards, strips",
   "v": "16px"
  },
  {
   "k": "Radius: tables, tab bar, selected device card",
   "v": "14px"
  },
  {
   "k": "Radius: tabs",
   "v": "12px 12px 0 0"
  },
  {
   "k": "Heights",
   "v": "button 46 (44 in overlay footer), field 38, close button 36, tab about 39 (was 46), pagination footer about 56 (was 60)"
  },
  {
   "k": "Gaps",
   "v": "6, 8, 10, 12, 16, 24"
  },
  {
   "k": "Page padding",
   "v": "24px content, 36px overlay"
  },
  {
   "k": "School screen: page padding",
   "v": "8px 24px 16px, gap 10px between breadcrumb, strip and table"
  },
  {
   "k": "School screen: breadcrumb",
   "v": "12px text; Back button padding 1px 10px 1px 4px"
  },
  {
   "k": "School screen: school strip",
   "v": "padding 26px 24px, gap 10px between name, address and info line. Info line shows dispatch and district only (no device count)"
  },
  {
   "k": "School screen: secondary links",
   "v": "gap 0 between links (each link keeps 7px 14px padding), 2px between wrapped lines"
  },
  {
   "k": "School screen: search and filter row",
   "v": "padding 10px 20px, fill #fafbfc, gap 12px"
  },
  {
   "k": "Compact density target",
   "v": "13-inch laptop window (about 1280 x 720): at least 6 table rows visible"
  },
  {
   "k": "Focus ring",
   "v": "ring 0 0 0 3px rgba(37,57,92,.25) on keyboard focus only (:focus-visible). Tab uses an inset 2px ring; Text field fills #eaeef5 when focused"
  }
 ]
